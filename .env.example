# ── Credenciales ───────────────────────────────────────────────────────────
# Si este fichero (.env) no existe, se usa como respaldo el .env del proyecto
# web (../ai-playwright-agent/.env), que ya tiene O2_LOGIN / O2_PASSWORD.
APP_URL=https://tv.o2online.de/
# Builds de deploy.mca.tid.es (p. ej. https://deploy.mca.tid.es/nightly/release/26.10.x-production-de-de/)
# piden HTTP Basic: se pasan aparte, nunca dentro de APP_URL.
APP_BASIC_USER=
APP_BASIC_PASSWORD=
O2_LOGIN=your_username
O2_PASSWORD=your_password
O2_PROFILE_NAME=

# ── canoway ─────────────────────────────────────────────────────────────────
CANOWAY_BASE_URL=https://canoway-de.cdn.telefonica.com/instance/45/service

# Versión de la app con la que se graban / contra la que se comparan contratos y mocks.
APP_VERSION=26.10.100

# ── Ejecución ───────────────────────────────────────────────────────────────
HEADLESS=true
# Presupuesto de latencia por llamada en los tests de API (ms).
API_LATENCY_BUDGET_MS=3000
# Los tests de API solo reproducen GET. true = también POST/PUT/DELETE grabados (switchProfile, eventos…).
API_ALLOW_MUTATIONS=false
